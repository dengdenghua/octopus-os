{
  "name": "octopus-frontend",
  "version": "0.2.0",
  "description": "Octopus — Multi-Agent AI Framework frontend workspace",
  "author": "Octopus Authors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/octopus-agent/octopus-agent.git",
    "directory": "frontend"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "demo:save": "node scripts/save-demo.js",
    "build": "vite build",
    "check": "tsc --noEmit",
    "dev": "vite",
    "dev:full": "concurrently -k -n BACKEND,FRONTEND -c green,blue \"python -m runtime serve --config ../config.local.yaml --port 8000\" \"pnpm dev\"",
    "dev:full:example": "concurrently -k -n BACKEND,FRONTEND -c green,blue \"python -m runtime serve --config ../config.example.yaml --port 8000\" \"pnpm dev\"",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently -k -s first -n VITE,APP -c blue,magenta \"vite\" \"wait-on tcp:127.0.0.1:3000 && electron electron/main.cjs\"",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "preview": "vite preview",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "bench": "vitest bench",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "generate-types": "openapi-typescript ../docs/openapi-snapshot.json -o src/core/api/openapi-types.ts"
  },
