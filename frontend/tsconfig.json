{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "checkJs": false,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "motion/react": ["./src/lib/motion-shim.tsx"],
      "mermaid-real": ["./node_modules/mermaid/dist/mermaid.d.ts"],
      "mermaid": ["./src/lib/mermaid-shim.ts"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/router.tsx",
    "src/app/page.tsx",
    "src/app/login/page.tsx",
    "src/app/register/page.tsx",
    "src/app/about/page.tsx",
    "src/app/browser/page.tsx",
    "src/types/electron.d.ts",
    "vite-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "src/app/api", "src/app/mock"]
}
