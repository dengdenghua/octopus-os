{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/schemas/echo-app.schema.json",
  "title": "Echo App Manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "enum": ["1"]
    },
    "category": {
      "type": "string"
    },
    "apps": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/app"
      }
    }
  },
  "required": ["apps"],
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "app_id": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "shortDescription": {
          "type": "string"
        },
        "short_description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "main": {
          "type": "string"
        },
        "connector_id": {
          "type": "string"
        },
        "connectorId": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/action"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/action"
              }
            }
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "input_schema": {
          "type": "object"
        },
        "inputSchema": {
          "type": "object"
        },
        "schema": {
          "type": "object"
        },
        "parameters": {
          "type": "object"
        },
        "requires_confirmation": {
          "type": "boolean"
        },
        "confirm": {
          "type": "boolean"
        }
      }
    }
  }
}
