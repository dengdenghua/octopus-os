// Echo Agent profile · desktop_operator.
//
// DEPRECATED as a standalone persona — desktop control is a *capability*
// (the `desktop_operator` arm, now folded into Echo/general). This
// folder exists for backward compatibility with tests + tooling that
// still construct the old standalone agent. `make_all_agent_presets`
// does NOT auto-register this agent; callers who want it must call
// `make_desktop_operator_agent(runtime)` explicitly.

{
  "id": "desktop_operator",
  "templateId": "desktop-operator",
  "templateVersion": "1.0.0",
  "name": "Desktop Operator",
  "icon": "🖥️",
  "description": "[legacy] desktop automation persona · see/click/type. Consider using general + desktop_operator arm instead.",
  "avatar": "avatar.png",
  "model": {"provider": "auto", "name": "auto"},
  "runtime": "local",
  "creator": "echo",
  "defaultProject": {"dir": "project"}
}
