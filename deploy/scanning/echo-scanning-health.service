[Unit]
Description=Verify Echo OS native scanning before login
Documentation=file:/usr/share/doc/echo-os/scanning.md
After=local-fs.target systemd-udevd.service
Before=sddm.service echo-desktop.service boot-complete.target

[Service]
Type=oneshot
ExecStart=/usr/lib/echo-os/echo-scanning-health
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
RequiredBy=sddm.service echo-desktop.service boot-complete.target
