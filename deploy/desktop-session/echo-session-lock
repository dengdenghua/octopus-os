#!/usr/bin/env bash
# Configure X11 idle policy and stay attached to logind through xss-lock.
set -euo pipefail

IDLE_SECONDS="${ECHO_LOCK_IDLE_SECONDS:-600}"
DISPLAY_OFF_SECONDS="${ECHO_LOCK_DISPLAY_OFF_SECONDS:-900}"

if [[ "${ECHO_SESSION_LOCK_TESTING:-no}" == yes ]]; then
  XSET_BIN="${ECHO_LOCK_XSET_BIN:?missing test xset path}"
  XSS_LOCK_BIN="${ECHO_LOCK_XSS_LOCK_BIN:?missing test xss-lock path}"
  SCREEN_LOCKER="${ECHO_LOCK_SCREEN_LOCKER:?missing test screen-locker path}"
  MINIMUM_IDLE_SECONDS=1
else
  XSET_BIN=/usr/bin/xset
  XSS_LOCK_BIN=/usr/bin/xss-lock
  SCREEN_LOCKER=/usr/lib/echo-os/echo-screen-locker
  MINIMUM_IDLE_SECONDS=60
fi

if [[ ! "$IDLE_SECONDS" =~ ^[0-9]+$ ]] || \
   (( IDLE_SECONDS < MINIMUM_IDLE_SECONDS || IDLE_SECONDS > 86400 )); then
  echo "Echo OS lock idle timeout is invalid: $IDLE_SECONDS" >&2
  exit 2
fi
if [[ ! "$DISPLAY_OFF_SECONDS" =~ ^[0-9]+$ ]] || \
   (( DISPLAY_OFF_SECONDS < IDLE_SECONDS || DISPLAY_OFF_SECONDS > 86400 )); then
  echo "Echo OS display-off timeout must be at least the lock timeout" >&2
  exit 2
fi
for executable in "$XSET_BIN" "$XSS_LOCK_BIN" "$SCREEN_LOCKER"; do
  [[ -x "$executable" ]] || {
    echo "Echo OS lock dependency is missing: $executable" >&2
    exit 1
  }
done
[[ -n "${DISPLAY:-}" ]] || {
  echo "Echo OS lock service requires an X11 display" >&2
  exit 1
}

"$XSET_BIN" s "$IDLE_SECONDS" "$IDLE_SECONDS"
"$XSET_BIN" +dpms
"$XSET_BIN" dpms 0 0 "$DISPLAY_OFF_SECONDS"

export XSECURELOCK_PAM_SERVICE=echo-lock
export XSECURELOCK_SHOW_USERNAME=1
export XSECURELOCK_SHOW_HOSTNAME=1
export XSECURELOCK_SAVER=saver_blank

exec "$XSS_LOCK_BIN" --transfer-sleep-lock -- "$SCREEN_LOCKER"
