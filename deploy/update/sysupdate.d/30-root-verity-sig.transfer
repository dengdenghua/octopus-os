[Transfer]
ProtectVersion=%A
# Authentication is completed by echo-os-update before systemd-sysupdate runs.
Verify=no

[Source]
Type=regular-file
Path=.
PathRelativeTo=explicit
MatchPattern=echo-os_@v.root-verity-sig.@u.raw.zst

[Target]
Type=partition
Path=auto
MatchPartitionType=root-x86-64-verity-sig
MatchPattern=echo-root-@v-verity-sig
InstancesMax=2
ReadOnly=yes
