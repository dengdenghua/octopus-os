[Unit]
Description=Echo OS read-only DLNA media server
Documentation=man:minidlnad(8) man:minidlna.conf(5)
After=local-fs.target network.target echo-firewall-health.service
Requires=echo-firewall-health.service
ConditionPathExists=/etc/echo-os/minidlna.conf

[Service]
Type=simple
User=minidlna
Group=minidlna
SupplementaryGroups=users
RuntimeDirectory=echo-dlna echo-dlna/media
RuntimeDirectoryMode=0750
StateDirectory=echo-dlna
StateDirectoryMode=0750
Environment=PYTHONPATH=/opt/echo-agent/site-packages
ExecStartPre=+/usr/bin/python3 -m appliance.native_dlna verify-start
ExecStart=/usr/sbin/minidlnad -f /etc/echo-os/minidlna.conf -P /run/echo-dlna/minidlna.pid -S -r
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
ReadWritePaths=/var/lib/echo-dlna
InaccessiblePaths=-/data -/mnt -/srv -/fs -/volume

[Install]
WantedBy=multi-user.target
