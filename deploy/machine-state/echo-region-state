#!/usr/bin/env python3
"""Persist locale, console/X11 keymap and timezone outside the A/B roots."""

from __future__ import annotations

import json
import os
import stat
import subprocess
import sys
from pathlib import Path

STATE_DIRECTORY = Path("/var/lib/echo-os")
STATE_FILE = STATE_DIRECTORY / "region-state.json"
LOCALE_CONF = Path("/etc/locale.conf")
VCONSOLE_CONF = Path("/etc/vconsole.conf")
LOCALTIME = Path("/etc/localtime")
TIMEZONE_FILE = Path("/etc/timezone")
ZONEINFO_DIRECTORY = Path("/usr/share/zoneinfo")
DEFAULT_LOCALE = "C.UTF-8"
DEFAULT_KEYMAP = "us"
DEFAULT_TIMEZONE = "UTC"
MAX_ATTEMPTS = 5


class InputError(ValueError):
    """A user-facing regional-setting validation error."""


def require_root() -> None:
    if os.geteuid() != 0:
        raise PermissionError("Echo OS regional-state management must run as root")


def command_environment() -> dict[str, str]:
    environment = dict(os.environ)
    environment["LC_ALL"] = "C.UTF-8"
    return environment


def run_output(command: list[str]) -> str:
    return subprocess.run(
        command,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
        env=command_environment(),
    ).stdout


def run_checked(command: list[str]) -> None:
    subprocess.run(command, check=True, text=True, env=command_environment())


def available_catalog(kind: str) -> frozenset[str]:
    commands = {
        "locale": ["/usr/bin/localectl", "list-locales", "--no-pager"],
        "keymap": ["/usr/bin/localectl", "list-keymaps", "--no-pager"],
        "timezone": ["/usr/bin/timedatectl", "list-timezones", "--no-pager"],
    }
    try:
        command = commands[kind]
    except KeyError as error:
        raise RuntimeError(f"unknown regional catalog: {kind}") from error
    values = frozenset(line.strip() for line in run_output(command).splitlines() if line.strip())
    if kind == "locale":
        utf8_aliases = {
            f"{value[:-5]}.UTF-8" for value in values if value.casefold().endswith(".utf8")
        }
        values = values | utf8_aliases | {DEFAULT_LOCALE}
    if not values:
        raise RuntimeError(f"system {kind} catalog is empty")
    return values


def validate_choice(kind: str, raw: str, available: frozenset[str] | None = None) -> str:
    value = raw.strip()
    choices = available if available is not None else available_catalog(kind)
    if value not in choices:
        raise InputError(f"unsupported {kind}: {value or '<empty>'}")
    return value


def validate_region(
    locale: str,
    keymap: str,
    timezone: str,
    *,
    catalogs: dict[str, frozenset[str]] | None = None,
) -> dict[str, str]:
    choices = catalogs or {
        "locale": available_catalog("locale"),
        "keymap": available_catalog("keymap"),
        "timezone": available_catalog("timezone"),
    }
    return {
        "locale": validate_choice("locale", locale, choices["locale"]),
        "keymap": validate_choice("keymap", keymap, choices["keymap"]),
        "timezone": validate_choice("timezone", timezone, choices["timezone"]),
    }


def read_assignment(path: Path, key: str, default: str) -> str:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return default
    except OSError as error:
        raise RuntimeError(f"unable to read regional configuration: {path}") from error
    prefix = f"{key}="
    for line in lines:
        if line.startswith(prefix):
            return line[len(prefix) :].strip().strip('"\'')
    return default


def current_timezone() -> str:
    try:
        resolved = LOCALTIME.resolve(strict=True)
        return str(resolved.relative_to(ZONEINFO_DIRECTORY.resolve(strict=True)))
    except (FileNotFoundError, OSError, ValueError):
        try:
            value = TIMEZONE_FILE.read_text(encoding="utf-8").strip()
        except FileNotFoundError:
            return DEFAULT_TIMEZONE
        except OSError as error:
            raise RuntimeError("unable to read the active timezone") from error
        return value or DEFAULT_TIMEZONE


def current_region() -> dict[str, str]:
    return validate_region(
        read_assignment(LOCALE_CONF, "LANG", DEFAULT_LOCALE),
        read_assignment(VCONSOLE_CONF, "KEYMAP", DEFAULT_KEYMAP),
        current_timezone(),
    )


def atomic_private_write(path: Path, content: str) -> None:
    STATE_DIRECTORY.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(STATE_DIRECTORY, 0o700)
    temporary = STATE_DIRECTORY / f".{path.name}.{os.getpid()}.tmp"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(STATE_DIRECTORY, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        temporary.unlink(missing_ok=True)


def require_private_root_file(path: Path) -> None:
    try:
        metadata = path.stat()
    except OSError as error:
        raise RuntimeError(f"persistent regional state is missing: {path}") from error
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0:
        raise RuntimeError("persistent regional state must be a regular root-owned file")
    if stat.S_IMODE(metadata.st_mode) != 0o600:
        raise RuntimeError("persistent regional state mode must be 0600")


def write_state(region: dict[str, str]) -> None:
    validated = validate_region(region["locale"], region["keymap"], region["timezone"])
    payload = {"schema": 1, **validated}
    atomic_private_write(STATE_FILE, json.dumps(payload, sort_keys=True) + "\n")


def read_state() -> dict[str, str]:
    require_private_root_file(STATE_FILE)
    try:
        payload = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError("persistent regional state is corrupt") from error
    if not isinstance(payload, dict) or payload.get("schema") != 1:
        raise RuntimeError("persistent regional state schema is unsupported")
    if set(payload) != {"schema", "locale", "keymap", "timezone"}:
        raise RuntimeError("persistent regional state has unexpected fields")
    return validate_region(
        str(payload["locale"]),
        str(payload["keymap"]),
        str(payload["timezone"]),
    )


def apply_region(region: dict[str, str]) -> None:
    validated = validate_region(region["locale"], region["keymap"], region["timezone"])
    run_checked(["/usr/bin/localectl", "set-locale", f"LANG={validated['locale']}"])
    run_checked(["/usr/bin/localectl", "set-keymap", validated["keymap"]])
    run_checked(["/usr/bin/timedatectl", "set-timezone", validated["timezone"]])


def readiness(region: dict[str, str], source: str) -> None:
    print(
        "ECHO_REGION_STATE_READY "
        f"locale={region['locale']} keymap={region['keymap']} "
        f"timezone={region['timezone']} source={source}"
    )


def capture() -> int:
    require_root()
    region = current_region()
    write_state(region)
    readiness(region, "active-root")
    return 0


def restore_or_initialize() -> int:
    require_root()
    if not STATE_FILE.exists():
        region = current_region()
        write_state(region)
        readiness(region, "initialized-root")
        return 0
    region = read_state()
    apply_region(region)
    active = current_region()
    if active != region:
        raise RuntimeError(f"restored regional settings do not match persistent state: {active}")
    readiness(region, "persistent-var")
    return 0


def prompt_choice(label: str, kind: str, default: str, choices: frozenset[str]) -> str:
    for _attempt in range(MAX_ATTEMPTS):
        raw = input(f"{label} [{default}]: ").strip() or default
        try:
            return validate_choice(kind, raw, choices)
        except InputError as error:
            print(f"Invalid value: {error}", file=sys.stderr)
    raise RuntimeError(f"too many invalid attempts for {label}")


def configure() -> int:
    require_root()
    catalogs = {
        "locale": available_catalog("locale"),
        "keymap": available_catalog("keymap"),
        "timezone": available_catalog("timezone"),
    }
    current = current_region()
    print("\nRegional settings")
    print("Examples: locale zh_CN.UTF-8, keymap us, timezone Asia/Shanghai")
    locale = prompt_choice("System locale", "locale", current["locale"], catalogs["locale"])
    keymap = prompt_choice("Console/keyboard map", "keymap", current["keymap"], catalogs["keymap"])
    timezone = prompt_choice("Time zone", "timezone", current["timezone"], catalogs["timezone"])
    region = {"locale": locale, "keymap": keymap, "timezone": timezone}
    apply_region(region)
    active = current_region()
    if active != region:
        raise RuntimeError(f"configured regional settings were not activated: {active}")
    write_state(region)
    readiness(region, "oem-configured")
    return 0


def configure_values(locale: str, keymap: str, timezone: str) -> int:
    """Apply preselected OEM values through the same installed catalogs."""
    require_root()
    region = validate_region(locale, keymap, timezone)
    apply_region(region)
    active = current_region()
    if active != region:
        raise RuntimeError(f"configured regional settings were not activated: {active}")
    write_state(region)
    readiness(region, "oem-credential")
    return 0


def main(argv: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    actions = {
        "--capture": capture,
        "--restore-or-initialize": restore_or_initialize,
        "--configure": configure,
    }
    if len(arguments) == 4 and arguments[0] == "--configure-values":
        action = lambda: configure_values(arguments[1], arguments[2], arguments[3])
    elif len(arguments) == 1 and arguments[0] in actions:
        action = actions[arguments[0]]
    else:
        print(
            "usage: echo-region-state "
            "{--configure|--configure-values LOCALE KEYMAP TIMEZONE|"
            "--capture|--restore-or-initialize}",
            file=sys.stderr,
        )
        return 2
    try:
        return action()
    except (
        InputError,
        OSError,
        PermissionError,
        RuntimeError,
        subprocess.CalledProcessError,
    ) as error:
        print(f"regional-state operation failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
