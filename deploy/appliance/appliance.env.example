# Copy this file to appliance.env and edit only the settings needed by this NAS.
# The immutable release image is kept separately in echo-release.env.

# Host identity used for files written into the bind-mounted state and NAS paths.
PUID=1000
PGID=1000

# Required internal control-plane secret. Generate once and keep it in appliance.env:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
ECHO_DOCKER_PROXY_TOKEN=

# Plain HTTP is for a trusted LAN only. Production TLS is started with start-tls.sh.
PORT=8000
ECHO_BIND_ADDRESS=0.0.0.0
# 手机控制通道。监听器默认关闭，只有管理员在“设备连接”中批准启用后才接受连接。
ECHO_DEVICE_LINK_PORT=8765
ECHO_DEVICE_LINK_BIND_ADDRESS=0.0.0.0
# 可选：NAS 的 RFC1918 地址、单标签主机名或 *.local；通常可从打开桌面的地址自动取得。
ECHO_DEVICE_LINK_HOST=
# 手机配对深链中的局域网备份端口；使用反向代理时应填手机实际访问的端口。
ECHO_DEVICE_SYNC_PORT=8000

# Use an absolute path on the NAS for production data.
NAS_STORAGE=./storage
# NAS_STORAGE 直接指向某个 OMV 共享目录时填写其 UUID；指向文件系统根时留空。
ECHO_NAS_OMV_SHARED_FOLDER_REF=

# Optional exact origins for applications embedded by the Echo desktop.
ECHO_APPLIANCE_FRAME_ORIGINS=
ECHO_APPLIANCE_CONNECT_ORIGINS=

# Optional Agent/provider configuration. Secrets may also be injected by the host.
ANTHROPIC_API_KEY=
ECHO_LOG_LEVEL=INFO
