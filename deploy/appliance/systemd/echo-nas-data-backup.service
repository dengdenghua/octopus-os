[Unit]
Description=Echo OS verified multi-volume NAS data backup
After=local-fs.target remote-fs.target echo-btrfs-snapshot.service
ConditionPathExists=/etc/echo-os/nas-data-backup-schedule.json

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/echo-os
LoadCredentialEncrypted=echo-nas-backup-password
ExecStart=/opt/echo-os/.venv/bin/python -m deploy.appliance.nas_data_backup_schedule_runner
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SYS_ADMIN
ReadWritePaths=-/data -/mnt -/srv -/fs -/volume -/var/lib/echo-os -/run/echo-os
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
SyslogIdentifier=echo-nas-data-backup

