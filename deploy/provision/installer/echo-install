#!/bin/sh
# Echo OS 装机 TUI —— 寄生在 Debian Installer 之前跑,只负责"问清几件事"。
#
# 为什么这么做(直接来自参考 NAS 逆向的结论):
#   参考 NAS的 initrd 里只多了 3 个自研文件,注入点只有两行 —— 选盘 TUI 跑在
#   debian-installer-startup 里,跑完 chvt 交给 d-i。分区、网络、镜像校验、
#   grub 安装全是白拿的。这是成本最低、也最稳的装机改造方式。
#
# 本脚本同样**不改 d-i 一行代码**:把用户的答案写成 debconf 预置
# (debconf-set-selections),d-i 起来后从 debconf 数据库里读,照常跑完剩余流程。
#
# 运行环境:d-i initrd(BusyBox + cdebconf)。不要假设有 Python/Bash/whiptail。
# 用法:由 debian-installer-startup 在 d-i 主程序之前调用。
set -e

ANSWERS=/tmp/echo-answers.conf
LOG=/tmp/echo-install.log
DONE=${ECHO_INSTALL_DONE:-/tmp/echo-install.completed}
# preseed.cfg needs 512 + 2048 + 30000 decimal MB, plus partition alignment.
# 32 GiB is a conservative lower bound; keep the recipe contract test in sync.
MIN_SYSTEM_DISK_KB=33554432

log() {
  printf '%s\n' "$*" >>"$LOG"
  [ ! -w /dev/tty4 ] || printf 'echo-install: %s\n' "$*" >/dev/tty4
}

# d-i 会在 reopen-console 与 file-preseed 两个阶段读取内置 preseed，因而
# preseed/early_command 可能执行两次。答案已经写入 debconf 数据库时必须直接
# 返回，否则用户会看到第二轮装机问题。
if [ -f "$DONE" ]; then
  log "already-complete"
  exit 0
fi
: >"$ANSWERS"
: >"$LOG"

# ── 小工具 ────────────────────────────────────────────────
# selftest 用 whiptail 桩保持轻量；真实 d-i 没有 whiptail，使用其原生 debconf
# frontend。后者会自动适配文本 newt 与 GTK 安装器。
USE_WHIPTAIL=0
if [ "${ECHO_TEST_DISKS+X}" = "X" ] && command -v whiptail >/dev/null 2>&1; then
  USE_WHIPTAIL=1
else
  DEBCONF_MODULE=${ECHO_DEBCONF_MODULE:-/usr/share/debconf/confmodule}
  . "$DEBCONF_MODULE"
  debconf-loadtemplate echo-os /echo-install.templates
  db_settitle echo-os/title
fi

die() {
  log "ERROR: $1"
  if [ "$USE_WHIPTAIL" -eq 1 ]; then
    whiptail --msgbox "$1" 10 60 || true
  else
    db_subst echo-os/error MESSAGE "$1"
    db_fset echo-os/error seen false
    db_input critical echo-os/error || true
    db_go || true
    db_stop || true
  fi
  exit 1
}

# 枚举整盘。注意:d-i 的 initrd 里**不一定有 lsblk**(util-linux 未必进 initrd),
# 官方做法是用 di-utils 提供的 list-devices。这里三级回落,保证总能拿到盘。
#
# 测试接缝:设了 ECHO_TEST_DISKS 就直接用注入的列表,不碰真实硬件。
# 生产环境不会设置它 —— 仅 selftest.sh 用,否则装机脚本无法在非 Linux 上验证。
list_disks() {
  # ${VAR+X} 语义:变量"设置过"(哪怕为空)就命中 —— 空列表=无盘,也是合法注入。
  # 若用 [ -n ],空串会误回落到真实硬件枚举,selftest 的无盘场景就失效。
  if [ "${ECHO_TEST_DISKS+X}" = "X" ]; then
    echo "$ECHO_TEST_DISKS" | tr ' ' '\n'
    return
  fi
  if command -v list-devices >/dev/null 2>&1; then
    devices=$(list-devices disk 2>/dev/null || true)
    if [ -n "$devices" ]; then
      printf '%s\n' "$devices"
      return
    fi
  fi
  if command -v lsblk >/dev/null 2>&1; then
    devices=$(lsblk -nd -o NAME 2>/dev/null || true)
    if [ -n "$devices" ]; then
      printf '%s\n' "$devices"
      return
    fi
  fi
  # 最后手段:直接从 /proc/partitions 过滤整盘(名字末尾没有数字分区号)
  awk '$4 ~ /^(sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+|mmcblk[0-9]+)$/ {print $4}' \
    /proc/partitions 2>/dev/null
}

# 容量(KB)。/sys/block/<dev>/size 的单位是 512B 扇区,最可靠。
disk_size_kb() {
  # 见 list_disks 的测试接缝说明(同样必须区分"设置但为空")
  if [ "${ECHO_TEST_DISKS+X}" = "X" ]; then
    echo "${ECHO_TEST_DISK_KB:-500000000}"
    return
  fi
  if [ -r "/sys/block/$1/size" ]; then
    awk -v s="$(cat "/sys/block/$1/size")" 'BEGIN{printf "%d", s/2}'
  else
    awk -v d="$1" '$4==d {print $3}' /proc/partitions 2>/dev/null
  fi
}

disk_model() {
  # 厂商型号里偶尔带单引号,会破坏后面 eval 拼 whiptail 参数,直接剔掉。
  for f in "/sys/block/$1/device/model" "/sys/block/$1/device/name"; do
    [ -r "$f" ] && { tr -d "\n,'\"" <"$f" 2>/dev/null; return; }
  done
  echo ""
}

human_size() {
  awk -v kb="$1" 'BEGIN{
    gb = kb / 1048576
    if (gb >= 1024) printf "%.1f TB", gb / 1024
    else if (gb >= 1) printf "%.0f GB", gb
    else printf "%d MB", kb / 1024
  }'
}

DISKS=$(list_disks | tr '\n' ' ' )
log "disks=$DISKS"
[ -n "$DISKS" ] || die "No usable installation disk was found."

# ── 1. 欢迎 ───────────────────────────────────────────────
if [ "$USE_WHIPTAIL" -eq 1 ]; then
  whiptail --title "Echo OS" --msgbox \
"欢迎安装 Echo OS。

开机即进 Agent 桌面:对话 / 文件 / 应用三原语,
存储底座来自 ZFS 与 Samba 等上游开源组件。

接下来只需回答几个问题。" 16 62 || true
else
  db_fset echo-os/welcome seen false
  db_input critical echo-os/welcome || true
  db_go || exit 1
fi

# ── 2. 系统盘 ─────────────────────────────────────────────
# whiptail --radiolist 每项三个参数:tag / 描述 / 状态(首项默认选中)。
#
# 用 POSIX 位置参数收参数,**不要用 eval 拼字符串**:eval 会重新解析整行,提示语
# 里的括号会被当成 shell 语法。位置参数既兼容 d-i 的 BusyBox sh，也保留空格。
set --
first=1
first_choice=""
DISK_CHOICES=""
ELIGIBLE_DISKS=""
for dev in $DISKS; do
  dev=${dev#/dev/}
  kb=$(disk_size_kb "$dev")
  # 排除容量未知或放不下预置分区布局的磁盘，不能等到分区阶段才失败。
  case "$kb" in ''|*[!0-9]*) continue ;; esac
  [ "$kb" -ge "$MIN_SYSTEM_DISK_KB" ] || continue
  ELIGIBLE_DISKS="$ELIGIBLE_DISKS $dev"

  state=OFF
  [ $first -eq 1 ] && { state=ON; first=0; }
  description="$dev  $(human_size "$kb")  $(disk_model "$dev")"
  [ "$state" = ON ] && first_choice=$description
  set -- "$@" "$dev" "$description" "$state"
  if [ -n "$DISK_CHOICES" ]; then
    DISK_CHOICES="$DISK_CHOICES, $description"
  else
    DISK_CHOICES=$description
  fi
done

[ "$#" -gt 0 ] || die "No usable installation disk of at least 32 GiB was found."

set +e
if [ "$USE_WHIPTAIL" -eq 1 ]; then
  SYSDEV=$(whiptail --title '选择系统盘' --radiolist \
"选择安装系统的磁盘(建议用 SSD,系统会占用整盘)。

数据盘稍后可在桌面里组 ZFS 存储池,这里不用选。" 18 70 8 "$@" 3>&1 1>&2 2>&3)
  rc=$?
else
  db_subst echo-os/disk CHOICES "$DISK_CHOICES"
  db_set echo-os/disk "$first_choice"
  db_fset echo-os/disk seen false
  db_input critical echo-os/disk
  rc=$?
  if [ $rc -eq 0 ]; then
    db_go
    rc=$?
  fi
  if [ $rc -eq 0 ]; then
    db_get echo-os/disk
    SYSDEV=${RET%% *}
  fi
fi
set -e
[ $rc -eq 0 ] || exit 1
[ -n "$SYSDEV" ] || die "Select a system disk to continue."

validate_selected_disk() {
  case " $ELIGIBLE_DISKS " in
    *" $SYSDEV "*) ;;
    *) die "The selected disk is not an eligible installation target." ;;
  esac
  # A device may disappear while the user is answering the installer questions.
  selected_kb=$(disk_size_kb "$SYSDEV")
  case "$selected_kb" in
    ''|*[!0-9]*) die "Cannot verify the selected disk capacity." ;;
  esac
  [ "$selected_kb" -ge "$MIN_SYSTEM_DISK_KB" ] \
    || die "The system disk must have at least 32 GiB capacity."
}
validate_selected_disk

# 确认(整盘写入,不可撤销)
if [ "$USE_WHIPTAIL" -eq 1 ]; then
  whiptail --title "确认" --yesno \
"即将把系统安装到 /dev/$SYSDEV,该磁盘上的所有数据将被清除。

确定继续?" 12 60 || exit 1
else
  db_subst echo-os/confirm DEVICE "/dev/$SYSDEV"
  db_set echo-os/confirm false
  db_fset echo-os/confirm seen false
  db_input critical echo-os/confirm || true
  db_go || exit 1
  db_get echo-os/confirm
  [ "$RET" = true ] || exit 1
fi

# ── 3. 主机名 ─────────────────────────────────────────────
set +e
if [ "$USE_WHIPTAIL" -eq 1 ]; then
  HOSTNAME=$(whiptail --title "主机名" --inputbox \
"给这台设备起个名字(局域网访问用它,如 echo.local)。" \
10 60 "echo" 3>&1 1>&2 2>&3)
  rc=$?
else
  db_set echo-os/hostname echo
  db_fset echo-os/hostname seen false
  db_input critical echo-os/hostname
  rc=$?
  if [ $rc -eq 0 ]; then
    db_go
    rc=$?
  fi
  if [ $rc -eq 0 ]; then
    db_get echo-os/hostname
    HOSTNAME=$RET
  fi
fi
set -e
[ $rc -eq 0 ] || exit 1
[ -n "$HOSTNAME" ] || HOSTNAME=echo

# ── 4. 管理员密码 ─────────────────────────────────────────
while :; do
  set +e
  if [ "$USE_WHIPTAIL" -eq 1 ]; then
    PW1=$(whiptail --title "管理员密码" --passwordbox \
"设置管理员(用户名 echo)的密码,至少 8 位。" \
10 60 3>&1 1>&2 2>&3)
    rc1=$?
    PW2=$(whiptail --title "确认密码" --passwordbox "请再输入一次。" \
10 60 3>&1 1>&2 2>&3)
    rc2=$?
  else
    db_set echo-os/password ""
    db_set echo-os/password-again ""
    db_fset echo-os/password seen false
    db_fset echo-os/password-again seen false
    db_input critical echo-os/password
    rc1=$?
    if [ $rc1 -eq 0 ]; then
      db_input critical echo-os/password-again
      rc2=$?
    else
      rc2=$rc1
    fi
    if [ $rc1 -eq 0 ] && [ $rc2 -eq 0 ]; then
      db_go
      rc1=$?
      rc2=$rc1
    fi
    if [ $rc1 -eq 0 ] && [ $rc2 -eq 0 ]; then
      db_get echo-os/password
      PW1=$RET
      db_get echo-os/password-again
      PW2=$RET
    fi
  fi
  set -e
  [ $rc1 -eq 0 ] && [ $rc2 -eq 0 ] || exit 1

  if [ ${#PW1} -lt 8 ]; then
    if [ "$USE_WHIPTAIL" -eq 1 ]; then
      whiptail --msgbox "密码至少 8 位,请重新输入。" 9 50 || true
    else
      db_subst echo-os/error MESSAGE "The password must contain at least 8 characters."
      db_fset echo-os/error seen false
      db_input critical echo-os/error || true
      db_go || true
    fi
    continue
  fi
  if [ "$PW1" != "$PW2" ]; then
    if [ "$USE_WHIPTAIL" -eq 1 ]; then
      whiptail --msgbox "两次输入不一致,请重新输入。" 9 50 || true
    else
      db_subst echo-os/error MESSAGE "The two passwords do not match."
      db_fset echo-os/error seen false
      db_input critical echo-os/error || true
      db_go || true
    fi
    continue
  fi
  break
done

# ── 5. 写入 debconf 预置 ──────────────────────────────────
# 这些是 d-i 的官方开关,我们只是替用户填好答案 —— 不改 d-i 行为本身。
validate_selected_disk
cat >>"$ANSWERS" <<EOF
d-i partman-auto/disk string /dev/$SYSDEV
d-i partman-auto/method string regular
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i netcfg/get_hostname string $HOSTNAME
d-i netcfg/get_domain string local
d-i passwd/user-fullname string Echo Admin
d-i passwd/username string echo
d-i passwd/user-password password $PW1
d-i passwd/user-password-again password $PW1
EOF

log "answers-ready disk=/dev/$SYSDEV hostname=$HOSTNAME"
if [ "$USE_WHIPTAIL" -eq 1 ] && command -v debconf-set-selections >/dev/null 2>&1; then
  debconf-set-selections "$ANSWERS"
elif [ "$USE_WHIPTAIL" -eq 0 ]; then
  # partman 等模板在 early_command 阶段还未注册，直接 db_set 会返回 10。
  # cdebconf 的 debconf-set-selections 遇到这种情况会先注册 dummy 模板；
  # 在当前 frontend 内复刻同一逻辑，可避免另起 frontend 触发 reopen-console，
  # 后者会意外拉起第二个 Debian Installer。
  set_answer() {
    answer_name=$1
    answer_value=$2
    if ! db_set "$answer_name" "$answer_value"; then
      db_register debian-installer/dummy "$answer_name"
      db_set "$answer_name" "$answer_value"
      db_subst "$answer_name" ID "$answer_name"
    fi
    db_fset "$answer_name" seen true
  }
  set_answer partman-auto/disk "/dev/$SYSDEV"
  set_answer partman-auto/method regular
  set_answer partman-lvm/device_remove_lvm true
  set_answer partman-md/device_remove_md true
  set_answer partman-partitioning/confirm_write_new_label true
  set_answer partman/choose_partition finish
  set_answer partman/confirm true
  set_answer partman/confirm_nooverwrite true
  set_answer netcfg/get_hostname "$HOSTNAME"
  set_answer netcfg/get_domain local
  set_answer passwd/user-fullname "Echo Admin"
  set_answer passwd/username echo
  set_answer passwd/user-password "$PW1"
  set_answer passwd/user-password-again "$PW1"
fi
log "answers-applied"

# 清理明文密码(不留到 /target)
: >"$ANSWERS"
rm -f "$ANSWERS" 2>/dev/null || true

: >"$DONE"
[ "$USE_WHIPTAIL" -eq 1 ] || db_stop
log "complete"

exit 0
