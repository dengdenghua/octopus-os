[Unit]
Description=Echo OS first-boot provisioning
Documentation=https://github.com/dengdenghua/octopus-os
After=network-online.target
Wants=network-online.target
# 全部阶段跑完才会生成 services 哨兵;未跑完时重开机会自动续跑(脚本幂等)。
ConditionPathExists=!/var/lib/echo-os/firstboot/services

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=DEBIAN_FRONTEND=noninteractive
ExecStart=/opt/echo-os/deploy/provision/base/setup-base.sh
# ZFS DKMS plus the complete offline Python runtime can legitimately take
# longer than an hour on low-power NAS CPUs or software-emulated validation
# machines. Individual network/package operations are bounded and every stage
# is resumable, so a global deadline only turns slow success into a failed
# first boot.
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal
SyslogIdentifier=echo-firstboot

[Install]
WantedBy=multi-user.target
