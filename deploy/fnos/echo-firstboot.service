[Unit]
Description=Echo OS first-boot provisioning
Documentation=https://github.com/dengdenghua/octopus-os
After=network-online.target
Wants=network-online.target
# 全部阶段跑完才会生成 services 哨兵;未跑完时重开机会自动续跑(脚本幂等)。
ConditionPathExists=!/var/lib/echo-os/firstboot/services

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=DEBIAN_FRONTEND=noninteractive
ExecStart=/opt/echo-os/deploy/fnos/base/setup-base.sh
TimeoutStartSec=60min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=echo-firstboot

[Install]
WantedBy=multi-user.target
