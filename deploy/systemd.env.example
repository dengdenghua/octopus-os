# Required by deploy/systemd-config.yaml. Leave blank only while preparing the
# host: the service intentionally refuses startup without strong real values.
ANTHROPIC_API_KEY=
# Generate with the documented prefixed base64 command; hex-only values fail the entropy gate.
ECHO_LOCAL_AUTH_JWT_SECRET=
# Generate with local_auth.config.hash_password; keep the full bcrypt:$2b$... value.
ECHO_ADMIN_PASSWORD_HASH=
# Independent local-device token key: openssl rand -hex 32
ECHO_CLOUD_EDGE_TOKEN_SECRET=

# Optional operational overrides.
ECHO_LOG_LEVEL=INFO
ECHO_LOG_FORMAT=json
