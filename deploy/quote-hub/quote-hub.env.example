# QuoteHub standalone service. Copy to /etc/echo/quote-hub.env, replace
# placeholders, then keep the file echo-quote:echo-quote mode 0600.

# Service-owned JSON document containing the official relay credential. Expected
# shape is documented in README.md; do not put a real password in this example.
QUOTE_HUB_SECRET_FILE=/etc/echo/quote-hub-secret.json

# The app always talks HTTPS/WSS to Nginx. Nginx alone is allowed to bridge the
# legacy official HTTP/WS origin through the restricted internal locations.
QUOTE_HUB_UPSTREAM_URL=https://api.echo-age.com/internal/paper-origin/api

# Persistent token/cache state. The systemd unit grants write access only here.
QUOTE_HUB_STATE_DIR=/var/lib/echo/quote-hub

# Small-server defaults. All downstream subscriptions are merged before the
# upstream connection, and every client queue is bounded/drop-oldest.
QUOTE_HUB_MAX_CODES_PER_CLIENT=100
QUOTE_HUB_MAX_CLIENTS=50
QUOTE_HUB_MAX_UNION_CODES=500
QUOTE_HUB_QUEUE_SIZE=50
QUOTE_HUB_STALE_AFTER=12
QUOTE_HUB_UPSTREAM_TIMEOUT=12
QUOTE_HUB_HEALTH_CHECK_INTERVAL=1
QUOTE_HUB_FAILURE_THRESHOLD=3
QUOTE_HUB_RECOVERY_THRESHOLD=2
QUOTE_HUB_PRIMARY_RECOVERY_SECONDS=120
QUOTE_HUB_REST_INTERVAL=3
QUOTE_HUB_SSE_KEEPALIVE=15
# Force a fresh Nginx auth_request well before the 15-minute access-token TTL.
QUOTE_HUB_SSE_MAX_LIFETIME=600
# /readyz performs an actual quote request through the HTTPS origin bridge.
QUOTE_HUB_READINESS_PROBE_TIMEOUT=3
QUOTE_HUB_READINESS_CACHE_SECONDS=30

# Bind address and port are intentionally not configurable here. The hardened
# systemd unit is authoritative: 127.0.0.1:8091 only.
