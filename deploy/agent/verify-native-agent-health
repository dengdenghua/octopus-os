#!/usr/bin/env python3
"""Wait for the loopback Agent and prove its runtime source identity."""

from __future__ import annotations

import json
import os
import stat
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

MANIFEST = Path("/opt/echo-agent/agent-bundle.json")
BASE_URL = "http://127.0.0.1:8000"
MAX_JSON_BYTES = 1024 * 1024
BROKER_SOCKET = Path("/run/echo-storage-broker/broker.sock")
AUTH_STORE = Path("/var/lib/echo-agent/appliance-auth.json")
AGENT_ACCOUNT = "echo"


def _verify_storage_broker() -> None:
    site_packages = Path("/opt/echo-agent/site-packages")
    if not site_packages.is_dir() or site_packages.is_symlink():
        raise RuntimeError("native Agent site-packages boundary is unavailable")
    sys.path.insert(0, str(site_packages))
    try:
        from appliance.native_storage_broker import NativeStorageBrokerClient

        NativeStorageBrokerClient(BROKER_SOCKET, timeout=3.0).probe()
    finally:
        if sys.path and sys.path[0] == str(site_packages):
            sys.path.pop(0)


def _json_file(path: Path) -> dict[str, Any]:
    if path.is_symlink() or not path.is_file() or not 1 <= path.stat().st_size <= MAX_JSON_BYTES:
        raise RuntimeError(f"unsafe or missing Agent manifest: {path}")
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise RuntimeError(f"Agent manifest is not an object: {path}")
    return value


def _authorization_headers() -> dict[str, str]:
    import pwd

    site_packages = Path("/opt/echo-agent/site-packages")
    if not site_packages.is_dir() or site_packages.is_symlink():
        raise RuntimeError("native Agent site-packages boundary is unavailable")
    account = pwd.getpwnam(AGENT_ACCOUNT)
    parent = AUTH_STORE.parent.stat(follow_symlinks=False)
    info = AUTH_STORE.stat(follow_symlinks=False)
    if (
        AUTH_STORE.is_symlink()
        or not stat.S_ISREG(info.st_mode)
        or stat.S_IMODE(info.st_mode) != 0o600
        or info.st_uid != account.pw_uid
        or info.st_gid != account.pw_gid
        or stat.S_IMODE(parent.st_mode) != 0o700
        or parent.st_uid != account.pw_uid
        or parent.st_gid != account.pw_gid
    ):
        raise RuntimeError("native Agent authentication store is not private")
    sys.path.insert(0, str(site_packages))
    try:
        from appliance.auth import (
            ADMIN_USERNAME,
            normalized_accounts,
            read_auth_store,
        )
        from runtime.safety.auth.identity import encode_jwt_hs256

        payload = read_auth_store(AUTH_STORE)
        accounts = normalized_accounts(payload)
        secret = payload.get("jwt_secret")
        if (
            not isinstance(secret, str)
            or len(secret) < 32
            or ADMIN_USERNAME not in accounts
            or accounts[ADMIN_USERNAME].get("active") is not True
        ):
            raise RuntimeError("native Agent authentication store is incomplete")
        now = int(time.time())
        token = encode_jwt_hs256(
            {"sub": f"local:{ADMIN_USERNAME}", "iat": now, "exp": now + 60},
            secret=secret,
        )
    finally:
        if sys.path and sys.path[0] == str(site_packages):
            sys.path.pop(0)
    return {"Authorization": f"Bearer {token}"}


def _read(url: str, *, maximum: int, headers: dict[str, str] | None = None) -> bytes:
    request_headers = {"User-Agent": "echo-agent-health/1", **(headers or {})}
    request = urllib.request.Request(url, headers=request_headers)
    with urllib.request.urlopen(request, timeout=3) as response:  # nosec B310 - fixed loopback URL
        if response.status != 200:
            raise RuntimeError(f"unexpected HTTP status {response.status} from {url}")
        data = response.read(maximum + 1)
    if not data or len(data) > maximum:
        raise RuntimeError(f"unbounded or empty response from {url}")
    return data


def _verify_once(
    expected: dict[str, Any], *, headers: dict[str, str] | None = None
) -> tuple[str, int]:
    config_raw = _read(
        f"{BASE_URL}/api/appliance/config", maximum=MAX_JSON_BYTES, headers=headers
    )
    config = json.loads(config_raw)
    if not isinstance(config, dict):
        raise RuntimeError("native Agent config response is not an object")
    bundle = config.get("agent_bundle")
    source = expected.get("source")
    if not isinstance(bundle, dict) or not isinstance(source, dict):
        raise RuntimeError("native Agent config or image manifest is incomplete")
    if (
        bundle.get("verified") is not True
        or bundle.get("source_id") != source.get("source_id")
        or config.get("agent_ui_base") is not None
        or config.get("agent_workspace_url") is not None
    ):
        raise RuntimeError("running Agent identity or retired WebUI boundary is invalid")

    health_raw = _read(f"{BASE_URL}/api/health", maximum=MAX_JSON_BYTES, headers=headers)
    health = json.loads(health_raw)
    runtime = health.get("runtime") if isinstance(health, dict) else None
    if (
        not isinstance(runtime, dict)
        or health.get("status") != "ok"
        or runtime.get("name") != "echo-agent-runtime"
        or runtime.get("version") != bundle.get("version")
        or runtime.get("sourceId") != source.get("source_id")
        or runtime.get("verifiedBundle") is not True
    ):
        raise RuntimeError("running Agent health identity differs from the verified image bundle")

    # This route is installed by the full appliance.extension rather than the
    # generic Agent. Probing it with the private-store JWT prevents a healthy
    # generic runtime from hiding an extension or authentication failure.
    projection_raw = _read(
        f"{BASE_URL}/api/appliance/tasks?limit=1",
        maximum=MAX_JSON_BYTES,
        headers=headers,
    )
    projection = json.loads(projection_raw)
    tasks = projection.get("tasks") if isinstance(projection, dict) else None
    counts = projection.get("counts") if isinstance(projection, dict) else None
    if (
        not isinstance(projection, dict)
        or projection.get("schema") != "echo.task_projection.v1"
        or not isinstance(projection.get("available"), bool)
        or not isinstance(projection.get("generatedAt"), str)
        or not projection["generatedAt"]
        or not isinstance(counts, dict)
        or not isinstance(tasks, list)
        or len(tasks) > 1
        or not isinstance(projection.get("auditIntegrity"), dict)
    ):
        raise RuntimeError("native OS extension task projection is unavailable")

    # A native image is not boot-complete unless the exact Agent runtime can
    # discover persisted interrupted work. This is deliberately read-only:
    # boot reports recovery work but never takes over a lease or resumes a
    # checkpoint without the device owner's two explicit confirmations.
    recovery_raw = _read(
        f"{BASE_URL}/api/task-runs/recovery-queue?limit=200",
        maximum=MAX_JSON_BYTES,
        headers=headers,
    )
    recovery = json.loads(recovery_raw)
    if not isinstance(recovery, dict) or recovery.get("schema") != (
        "echo.task_recovery_queue.v1"
    ):
        raise RuntimeError("native Agent recovery queue response is incompatible")
    count = recovery.get("count")
    total = recovery.get("total")
    limit = recovery.get("limit")
    items = recovery.get("items")
    if (
        not isinstance(count, int)
        or isinstance(count, bool)
        or not isinstance(total, int)
        or isinstance(total, bool)
        or not isinstance(limit, int)
        or isinstance(limit, bool)
        or not isinstance(items, list)
        or count < 0
        or total < count
        or limit != 200
        or len(items) != count
        or count > limit
    ):
        raise RuntimeError("native Agent recovery queue has invalid bounds")
    for item in items:
        if (
            not isinstance(item, dict)
            or not str(item.get("task_id") or "").strip()
            or not str(item.get("recommended_action") or "").strip()
        ):
            raise RuntimeError("native Agent recovery queue contains an invalid item")
    return str(source["source_id"]), count


def main() -> int:
    expected = _json_file(MANIFEST)
    raw_timeout = os.environ.get("ECHO_AGENT_HEALTH_TIMEOUT_SECONDS", "120")
    if not raw_timeout.isdigit() or not 1 <= int(raw_timeout) <= 600:
        print("invalid ECHO_AGENT_HEALTH_TIMEOUT_SECONDS", file=sys.stderr)
        return 2
    deadline = time.monotonic() + int(raw_timeout)
    last_error = "Agent did not answer"
    while time.monotonic() < deadline:
        try:
            _verify_storage_broker()
            headers = _authorization_headers()
            source_id, recovery_count = _verify_once(
                expected,
                headers=headers,
            )
            print(
                f"ECHO_AGENT_READY source={source_id} endpoint={BASE_URL} recovery={recovery_count}"
            )
            return 0
        except (OSError, ValueError, KeyError, RuntimeError, urllib.error.URLError) as error:
            last_error = str(error)
            time.sleep(1)
    print(f"native Echo Agent failed its health gate: {last_error}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
