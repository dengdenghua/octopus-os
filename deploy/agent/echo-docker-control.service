[Unit]
Description=Echo OS least-privilege Docker and Hub control proxy
Documentation=file:/usr/share/doc/echo-os/native-docker-control.md
Requires=docker.service echo-docker-credential.service echo-native-storage-broker.service
After=docker.service echo-docker-credential.service echo-native-storage-broker.service
Before=echo-agent.service
ConditionPathExists=/var/run/docker.sock
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=echo-docker-control
Group=echo
SupplementaryGroups=docker
UMask=0077
LoadCredential=echo.docker-proxy-token:/var/lib/echo-os/docker-proxy-token
Environment=PYTHONPATH=/opt/echo-agent/site-packages
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=ECHO_NATIVE_OS=1
Environment=ECHO_DOCKER_DATA_ROOT_MOUNT=/run/echo-host/docker-data
Environment=ECHO_DOCKER_DATA_ROOT_EXPECTED=/var/lib/docker
ExecStart=/usr/bin/python3 -m appliance.docker_proxy --host 127.0.0.1 --port 2375

Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
BindReadOnlyPaths=/var/lib/docker:/run/echo-host/docker-data
ReadOnlyPaths=/opt/echo-agent /var/run/docker.sock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
