[Unit]
Description=Echo Agent native runtime for the Echo OS workbench
Documentation=file:/usr/lib/echo-os/image-contract
After=local-fs.target echo-local-account.service
ConditionPathExists=/opt/echo-agent/native-runtime.json
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=echo
Group=echo
WorkingDirectory=/var/lib/echo-agent
StateDirectory=echo-agent
StateDirectoryMode=0700
UMask=0077

Environment=PYTHONPATH=/opt/echo-agent/site-packages
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/echo
Environment=USER=echo
Environment=LOGNAME=echo
Environment=ECHO_NATIVE_OS=1
Environment=ECHO_PROMPT_SKILL_REFRESH_DEADLINE_S=0
Environment=ECHO_DISABLE_STUB_API=1
Environment=ECHO_APP_EXTENSIONS=appliance.native_extension
Environment=ECHO_DATA_DIR=/var/lib/echo-agent
Environment=ECHO_HOME=/var/lib/echo-agent
Environment=ECHO_RESOURCES_DIR=/opt/echo-agent/resources
Environment=ECHO_AGENT_BUNDLE_MANIFEST=/opt/echo-agent/agent-bundle.json
Environment=ECHO_CODEX_BUNDLE_DIR=/opt/echo-agent/codex
Environment=ECHO_CODEX_EXECUTABLE=/opt/echo-agent/codex/bin/codex
Environment=ECHO_NATIVE_AGENT_CONFIG=/opt/echo-agent/native-config.yaml
ExecStart=/usr/bin/python3 -m appliance.native_entrypoint

Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/echo-agent
ReadWritePaths=/home/echo
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
