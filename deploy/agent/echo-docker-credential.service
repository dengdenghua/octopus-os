[Unit]
Description=Provision the per-device Echo Docker control credential
Documentation=file:/usr/share/doc/echo-os/native-docker-control.md
After=local-fs.target
Before=echo-docker-control.service echo-agent.service
RequiresMountsFor=/var/lib/echo-os

[Service]
Type=oneshot
User=root
Group=root
StateDirectory=echo-os
StateDirectoryMode=0700
UMask=0077
Environment=PYTHONPATH=/opt/echo-agent/site-packages
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m appliance.docker_credential ensure
RemainAfterExit=yes

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/echo-agent
ReadWritePaths=/var/lib/echo-os
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_CHOWN
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
