[Unit]
Description=Verify Echo OS removable-storage integration before login
Documentation=file:/usr/share/doc/echo-os/removable-storage.md
Requires=udisks2.service
After=dbus.service systemd-udevd.service udisks2.service
Before=sddm.service echo-desktop.service boot-complete.target

[Service]
Type=oneshot
ExecStart=/usr/lib/echo-os/echo-removable-storage-health
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
RequiredBy=sddm.service echo-desktop.service boot-complete.target
