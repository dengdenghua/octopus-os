# Runtime-owned Agent state must never enter source snapshots or release
# provenance. Keep the bundled plugin catalog under .echo/plugins visible.
/.echo-home/
/.echo-tmp/
/.echo/*
!/.echo/plugins/
!/.echo/plugins/**
/.echo/plugins/**/__pycache__/
/.echo/plugins/**/*.py[cod]
agents/**/agent-core/tenants/
agents/**/agent-core/sessions/
agents/**/agent-core/workspace/
agents/**/agent-core/.scores.jsonl
agents/**/agent-core/*.transaction.lock

# Pre-Echo local state / reversible cleanup archives.
# Keep legacy local state ignored during migration without making it canonical.
.octo[p]us/*.json
.octo[p]us/*.jsonl
.octo[p]us/*.bak
.octo[p]us/*.lock
# tool-registry hot-reload artifacts under agents/
agents/**/*.jsonc.bak
agents/**/*.jsonc.lock
.octo[p]us/local/
.octo[p]us/research/
# (.echo/ is handled above by /.echo/* plus the !/.echo/plugins/ negations,
# which keep the bundled plugin catalog tracked. Do not re-ignore it here: a
# later .echo/plugins/ rule would silently defeat that negation.)
# (.echo-browser-relay/ used to live at root; moved to
# extensions/echo-browser-relay/ — committed product surface)
.octo[p]us/archive/
agents/*/workspace/
benchmarks/results/
skills_backup_*/

