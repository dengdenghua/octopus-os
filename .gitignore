# Connector CLI download caches. Each connector's cli.json installs its CLI at
# init time (npm install -g / pip install), so these archives are reproducible
# local caches, not delivery artifacts — ~100 MB that would be permanent in
# history. Mode 0600 on disk confirms they are downloads, not repo assets.
extensions/workbuddy-connectors/connectors/*/vendor/
