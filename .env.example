# Echo OS · 环境变量配置
# 复制为 .env 并按需修改。未设置的项使用默认值。

# ═══════════════════════════════════════════════════════════
# LLM providers
# ═══════════════════════════════════════════════════════════
# Anthropic Claude API key (required for Claude models)
ANTHROPIC_API_KEY=
# Custom base URL for Anthropic (e.g. proxy or regional endpoint)
ANTHROPIC_BASE_URL=
# OpenAI API key (for GPT models via OpenAI-compatible gateway)
OPENAI_API_KEY=
# Google Gemini API key
GEMINI_API_KEY=
# Local Ollama base URL (e.g. http://localhost:11434)
OLLAMA_BASE_URL=

# ═══════════════════════════════════════════════════════════
# Web search
# ═══════════════════════════════════════════════════════════
# 后端选择(可选):tavily | brave | serper | searxng | ddg
# 留空则按已配置的 API key 自动选择,全都没有时回落到 DDG HTML 抓取
WEB_SEARCH_BACKEND=

# Tavily —— https://tavily.com(面向 AI 的搜索)
TAVILY_API_KEY=

# Brave Search —— https://brave.com/search/api/(免费额度 2000 次/月)
BRAVE_API_KEY=

# Serper.dev —— https://serper.dev(Google 结果代理,按次付费)
SERPER_API_KEY=

# SearXNG —— 自建/公开实例的根 URL,例如 https://searx.example.com
# 可聚合 Google/Bing/百度/搜狗 等多个源
SEARXNG_URL=
SEARXNG_API_KEY=

# ═══════════════════════════════════════════════════════════
# Rerank (for research pipeline)
# ═══════════════════════════════════════════════════════════
# 后端选择(可选):bm25 | cohere。留空则有 COHERE_API_KEY 时走 cohere,否则 bm25
RERANK_BACKEND=

# Cohere Rerank v3 —— https://docs.cohere.com/reference/rerank
# 跨语言语义重排,不设就回落到本地 BM25
COHERE_API_KEY=

# ═══════════════════════════════════════════════════════════
# Server
# ═══════════════════════════════════════════════════════════
PORT=8000
# 后端宿主监听地址。普通内网直连默认 0.0.0.0；生产 TLS 启动器会强制改成 127.0.0.1，
# 只让固定摘要的网关发布 80/443。
# ECHO_BIND_ADDRESS=0.0.0.0
LEARN_INTERVAL_S=0   # 0 = 关闭定时反思 · 3600 = 每小时一次
# Docker/NAS 部署时设为拥有 data 与 NAS 共享目录的宿主用户/组 ID。
PUID=1000
PGID=1000
# Echo 主服务与内部 Docker 控制 sidecar 的共享密钥。部署前生成：
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
ECHO_DOCKER_PROXY_TOKEN=
# NAS 文件区的宿主路径。若直接绑定某个 OMV 共享目录，必须同时填写该共享 UUID；
# 若绑定的是对应 OMV 文件系统根，则 UUID 留空，Echo 按 relativePath 映射共享权限。
NAS_STORAGE=./storage
ECHO_NAS_OMV_SHARED_FOLDER_REF=
# OMV 部署可设为官方管理页 origin；只用于安全跳转，不把 OMV 密码交给 Echo。
# ECHO_OMV_ADMIN_URL=https://nas.example.com

# ═══════════════════════════════════════════════════════════
# Echo runtime paths
# ═══════════════════════════════════════════════════════════
# 数据目录(数据库、日志、缓存等)
# ECHO_DATA_DIR=/data
# Echo 主目录(配置、agents、skills 等)
# ECHO_HOME=
# 配置文件路径
# ECHO_CONFIG=/etc/echo/config.yaml
# WebUI 静态资源目录(前端构建产物)
# ECHO_WEBUI_DIST=
# 浏览器扩展目录
# ECHO_BROWSER_EXTENSION_DIR=
# 工作流目录
# ECHO_WORKFLOWS_DIR=
# 额外 prompt 目录(冒号分隔)
# ECHO_PROMPT_DIRS=

# ═══════════════════════════════════════════════════════════
# Feature flags
# ═══════════════════════════════════════════════════════════
# 身份锁:锁定 agent 身份不可被运行时修改
# ECHO_IDENTITY_LOCK=false
# 反思进化:启用 Regeneration 自动反思闭环
# ECHO_REGEN_ENABLED=false
# 反思间隔(秒)
# ECHO_REGEN_INTERVAL_SEC=600
# Camouflage A/B 实验:启用自动 A/B 测试
# ECHO_CAMOUFLAGE_ENABLED=false
# Camouflage 间隔(秒)
# ECHO_CAMOUFLAGE_INTERVAL_SEC=600
# GEPA 自动应用:自动应用进化优化结果
# ECHO_GEPA_AUTO_APPLY=false
# Skill Forge 自动晋升间隔(小时)
# ECHO_FORGE_AUTO_PROMOTE_INTERVAL_HOURS=24
# 不变量检查模式:strict | relaxed
# ECHO_INVARIANTS=strict

# ═══════════════════════════════════════════════════════════
# Security
# ═══════════════════════════════════════════════════════════
# 渠道凭据加密密钥（32 字节 URL-safe base64）；用于 channel credentials，
# 不会加密 appliance-auth.json。设备 JWT secret 的系统密钥库迁移仍是交付缺口。
# ECHO_CREDENTIAL_KEY=
# 反向代理/FQDN 部署时显式声明浏览器信任边界（逗号分隔）。直接私网 IP、localhost、
# *.local 和单标签 LAN 主机名无需配置。例：
# ECHO_APPLIANCE_TRUSTED_HOSTS=echo.home.example
# ECHO_APPLIANCE_TRUSTED_ORIGINS=https://echo.home.example
# Echo OS 窗口和浏览器直连的精确 CSP origin 白名单；默认只允许同源，不支持路径或 *。
# ECHO_APPLIANCE_FRAME_ORIGINS=https://jellyfin.home.example:8096
# ECHO_APPLIANCE_CONNECT_ORIGINS=https://storage.home.example,wss://events.home.example
# 反向代理容器/主机的精确 IP 或 CIDR；只信任这里的 X-Forwarded-*，默认仅 127.0.0.1。
# ECHO_TRUSTED_PROXY_IPS=172.20.0.10
# Docker appliance 内置 TLS 网关。证书必须覆盖这个精确 DNS 名或 IPv4 SAN；
# 私钥只接受 0400/0600。可改外部 80/443、固定网关 IP 和专用 subnet，均不支持通配代理。
# ECHO_TLS_HOST=echo.home.example
# ECHO_TLS_HTTP_PORT=80
# ECHO_TLS_HTTPS_PORT=443
# ECHO_TLS_BIND_ADDRESS=0.0.0.0
# ECHO_TLS_PROXY_IP=172.30.90.2
# ECHO_TLS_SUBNET=172.30.90.0/24
# 渠道状态持久化路径(如 WebSocket 连接状态)
# ECHO_CHANNEL_STATE=

# ═══════════════════════════════════════════════════════════
# docker-compose.full.yml · dependencies
# ═══════════════════════════════════════════════════════════
# Required by docker-compose.full.yml (redis + grafana services).
# Leave unset for `make up` / plain docker-compose.yml; set before `make up-full`.
# 生产环境必须修改为强密码(openssl rand -hex 32)
REDIS_PASSWORD=
GRAFANA_PASSWORD=

# ═══════════════════════════════════════════════════════════
# Observability (OpenTelemetry)
# ═══════════════════════════════════════════════════════════
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
# OTEL_SERVICE_NAME=echo-agent

# ═══════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════
# 日志级别:DEBUG | INFO | WARNING | ERROR
# ECHO_LOG_LEVEL=INFO
# 日志格式(Python logging format string)
# ECHO_LOG_FORMAT=%(asctime)s [%(levelname)s] %(name)s: %(message)s

# ═══════════════════════════════════════════════════════════
# Hearts (分布式锁 / HA)
# ═══════════════════════════════════════════════════════════
# ECHO_HEARTS_REDIS_URL=redis://localhost:6379/0
